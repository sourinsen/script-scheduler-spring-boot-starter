# EditorConfig helps maintain consistent coding styles for multiple developers
# working on the same project across various editors and IDEs
# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4
continuation_indent_size = 8

[*.{json,js,ts}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 120

[*.sh]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[Makefile]
indent_style = tab

[*.java]
indent_size = 4
continuation_indent_size = 8
max_line_length = 120
